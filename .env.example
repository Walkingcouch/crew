# ─────────────────────────────────────────────────────────────────
# Crew Platform: Environment Variables
# Copy this file to .env.local for local dev (never commit .env.local)
# Set these as Vercel Environment Variables in your project dashboard
# ─────────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project -> Settings -> API

SUPABASE_URL=https://ggocdbsspynihtqlgozv.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ggocdbsspynihtqlgozv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdnb2NkYnNzcHluaWh0cWxnb3p2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY2Nzk1NzUsImV4cCI6MjA5MjI1NTU3NX0.jUlzuNmhqprLlKy-iM3qSNTnhtg6FUgwRKWMy2Y3kWA

# Service role key: SERVER SIDE ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ── Email (Resend) ─────────────────────────────────────────────────
# Sign up at resend.com -> API Keys -> Create Key
# Used for: booking confirmations, invoice emails, report lead-gen emails

RESEND_API_KEY=re_your_key_here
EMAIL_FROM=hello@getcrew.com.au
ADMIN_EMAIL=hello@getcrew.com.au


# ── CheckVault escrow (checkvault.com.au) ─────────────────────────
# No public API docs are available yet, the owner is in onboarding
# discussions with CheckVault. Leave CHECKVAULT_ENVIRONMENT=mock until
# real credentials and sandbox docs arrive, see DEPLOY.md for the cutover
# plan (mock -> test -> production) and every // CHECKVAULT-SPEC marker in
# payments/checkvault-client.js that needs reconciling against real docs.

CHECKVAULT_ENVIRONMENT=mock          # 'mock' | 'test' | 'production'
CHECKVAULT_API_URL=https://api.checkvault.com.au/v1
CHECKVAULT_API_KEY=your_checkvault_api_key
CHECKVAULT_API_SECRET=your_checkvault_api_secret
CHECKVAULT_AUTH_MODE=bearer          # 'bearer' | 'hmac'
CHECKVAULT_WEBHOOK_SECRET=your_checkvault_webhook_secret
PAYMENTS_CARD_ENABLED=false


# ── AI assistant (/api/ai) ─────────────────────────────────────────
# Anthropic is used first if ANTHROPIC_API_KEY is set; otherwise falls
# back to a local Ollama instance at OLLAMA_URL if that's set instead.
# If neither is set, /api/ai returns a graceful 503.

ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434


# ── Auth ───────────────────────────────────────────────────────────
# See AUTH_SETUP.md for Google/Apple provider configuration in Supabase.
# Apple requires a paid Apple Developer account and may lag launch, the
# button on auth.html is hidden entirely while this is false.

AUTH_APPLE_ENABLED=false


# ── Beta access ────────────────────────────────────────────────────
# While true, sign-in (any method) is gated by the is_beta_allowed(email)
# RPC against the beta_allowlist table (see supabase/migrations).

BETA_MODE=true
BETA_ALLOWED_EMAILS=your@email.com.au,tester2@example.com


# ── Web Push (VAPID) ───────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# The public key is exposed to the browser via GET /api/config.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@getcrew.com.au

# Shared secret checked on POST /api/push/dispatch, which a Supabase
# Database Webhook calls on notifications INSERT (see DEPLOY.md).
PUSH_DISPATCH_SECRET=generate_a_long_random_string_here


# ── Cron (Vercel scheduled functions) ──────────────────────────────
# Vercel sets this automatically for its own cron invocations; set it
# yourself if triggering scripts/run-cron.js manually or from another host.

CRON_SECRET=generate_a_long_random_string_here


# ── App config ──────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=https://getcrew.com.au
NEXT_PUBLIC_APP_ENV=production   # 'development' | 'beta' | 'production'

# ─────────────────────────────────────────────────────────────────
# Crew Platform — Environment Variables
# Copy this file to .env.local for local dev (never commit .env.local)
# Set these as Vercel Environment Variables in your project dashboard
# ─────────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://ggocdbsspynihtqlgozv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — SERVER SIDE ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ── Email (Resend) ─────────────────────────────────────────────────
# Sign up at resend.com → API Keys → Create Key
# Used for: report lead-gen emails to councils, booking confirmations

RESEND_API_KEY=re_your_key_here
EMAIL_FROM=hello@getcrew.com.au


# ── Beta access list ───────────────────────────────────────────────
# Comma-separated emails allowed to sign in during beta
# If empty, all Supabase users are allowed

BETA_ALLOWED_EMAILS=your@email.com.au,tester2@example.com


# ── App config ────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=https://yourcustomdomain.com.au
NEXT_PUBLIC_APP_ENV=production   # 'development' | 'beta' | 'production'


# ── Zai (Assembly Payments) ────────────────────────────────────────
# Sign up at assemblypayments.com → Dashboard → Settings → API Keys
# Docs: https://developer.assemblypayments.com

# OAuth2 client credentials (server-side only — never expose to browser)
ZAI_CLIENT_ID=your_zai_client_id
ZAI_CLIENT_SECRET=your_zai_client_secret

# 'sandbox' during development, 'production' for live
ZAI_ENVIRONMENT=sandbox

# Browser-safe public key — used by Zai.js hosted-fields SDK in the browser
ZAI_PUBLIC_KEY=your_zai_public_key

# The Zai account ID that receives platform commission fees
# Found in: Zai Dashboard → Settings → Account → Account ID
ZAI_PLATFORM_ACCOUNT_ID=your_zai_platform_account_id

# Webhook signing secret — used to verify X-Zai-Signature on incoming events
# Found in: Zai Dashboard → Webhooks → Edit → Secret
ZAI_WEBHOOK_SECRET=your_zai_webhook_secret

# Set to 'true' to enable verbose Zai API request/response logging (dev only)
ZAI_LOG=false

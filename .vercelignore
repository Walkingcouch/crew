# Expo / React Native: built by EAS, not Vercel.
crew-app/

# Internal docs, screenshots and database schema: run via Supabase CLI,
# never served by the app.
documentation/
screenshots/
supabase/*.sql
supabase/migrations/
supabase/functions/

# Test suites: not served, run via `npm run test:payments` / `test:cron` / `test:e2e`.
**/__tests__/
tests/
e2e/
playwright-report/
test-results/

# Secrets: must never be deployed.
secrets.env
.env
.env.local

# Dev tooling.
.claude/
node_modules/

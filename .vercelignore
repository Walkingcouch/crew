# Legacy pre-Next.js monoliths: reference material only, not deployed.
# Removed entirely in the rebuild's final phase once parity is confirmed.
legacy/

# Expo / React Native: built by EAS, not Vercel.
crew-app/

# Internal docs, screenshots and database schema: run via Supabase CLI,
# never served by the app.
documentation/
screenshots/
supabase/*.sql
supabase/migrations/
supabase/functions/

# Test suites: not served, run via `npm run test:payments` / `test:cron` / `test:e2e`.
**/__tests__/
tests/

# Secrets: must never be deployed.
secrets.env
.env
.env.local

# Dev tooling.
.claude/
node_modules/
